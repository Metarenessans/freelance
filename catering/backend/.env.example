# Copy to .env locally; never commit actual values.
# A newly generated SECRET_KEY is required; blank intentionally fails closed.
SECRET_KEY=
DEBUG=False
# Keep demo protections on. Opt in only for synthetic portfolio submissions to an isolated DB.
DEMO_MODE=true
PORTFOLIO_ORDERING_ENABLED=false
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
TIME_ZONE=UTC
DB_ENGINE=postgresql
DB_NAME=catering_demo
DB_USER=catering_demo
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
# For offline tests only: DB_ENGINE=sqlite and SQLITE_PATH=:memory:
FRONTEND_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:8000
REVALIDATION_SECRET=
REVALIDATION_ENABLED=false
TELEGRAM_ENABLED=false
# Bot worker approval: comma-separated immutable numeric Telegram user IDs; empty denies all.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_PHONE_LOOKUP_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TG_API_ID=
TG_API_HASH=
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_SSL=False
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=notifications@example.com
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
