# Disabled by default. Use a newly created test bot, never original credentials.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Explicit approval by immutable numeric Telegram user IDs, comma-separated.
# Empty or malformed means deny all. Usernames/phone numbers alone never approve.
# Approved IDs must also match an active subscriber username or verified own phone.
TELEGRAM_ALLOWED_USER_IDS=
# The bot needs backend dependencies/settings and the same new isolated DB.
# Set the backend DB_* and SECRET_KEY environment variables in its worker service.
