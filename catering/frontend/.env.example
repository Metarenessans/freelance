# Local defaults. Copy to .env.local; never commit local environment files.
# Use a NEW isolated demo backend, never the original production service.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
INTERNAL_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_URL=http://127.0.0.1:8000
# Keep true on public previews until the isolated backend is verified safe.
NEXT_PUBLIC_DEMO_MODE=true
# Generate a new random server-only value; unset disables schema revalidation.
REVALIDATION_SECRET=
